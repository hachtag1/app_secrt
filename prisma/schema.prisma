generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Payment {
  id               String   @id @default(cuid())
  reference        String
  nomComplet       String
  montant          String
  moyenPaiement    String
  datePaiement     String
  numeroQuittance  String
  statutPaiement   String   @default("PAYE")
  service          String
  qrCodeData       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
